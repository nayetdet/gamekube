# Public origin of this Next.js app. Used for OIDC redirect URIs and cookies.
APP_URL=http://localhost:3000

# GameKube Spring Boot API.
BACKEND_API_URL=http://localhost:8081

# Keycloak realm issuer and the public (PKCE) client from the realm import.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/gamekube
KEYCLOAK_CLIENT_ID=frontend-client

# Encrypts the session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-32-byte-random-string

# Domain the cluster ingress serves game sessions on (backend `game.domain`).
GAME_SESSION_DOMAIN=gamekube.localhost

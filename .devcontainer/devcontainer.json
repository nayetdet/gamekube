{
  "name": "gamekube",
  "image": "ghcr.io/nayetdet/gamekube:devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "bash .devcontainer/scripts/init.sh",
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "forwardPorts": [3000, 8080, 7000],
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "runArgs": [
    "--network=host",
    "--security-opt=label=disable"
  ],
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.bun/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "josevseb.google-java-format-for-vs-code",
        "ms-azuretools.vscode-containers",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "Tim-Koehler.helm-intellisense",
        "redhat.vscode-yaml",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "[java]": {
          "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code",
          "editor.insertSpaces": true,
          "editor.tabSize": 2
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "files.associations": {
          "**/infra/kind/**.yaml": "plaintext",
          "**/templates/*.yaml": "helm",
          "**/templates/*.yml": "helm",
          "**/templates/*.tpl": "helm"
        },
        "editor.formatOnSave": true,
        "terminal.integrated.cwd": "${workspaceFolder}",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.import.gradle.enabled": true,
        "java.import.projectSelection": "automatic",
        "java.import.gradle.projectFolders": [
          "backend"
        ],
        "java.import.gradle.wrapper.enabled": true,
        "java.import.gradle.offline.enabled": false,
        "java.import.exclusions": [
          "**/frontend/**",
          "**/infra/**",
          "**/node_modules/**"
        ],
        "java.autobuild.enabled": true,
        "java.compile.nullAnalysis.mode": "automatic",
        "eslint.workingDirectories": [
          {
            "directory": "${workspaceFolder}/frontend",
            "changeProcessCWD": true
          }
        ],
        "js/ts.tsdk.path": "${workspaceFolder}/frontend/node_modules/typescript/lib"
      }
    }
  }
}
